{
  "name": "@jimbonlemu/word-hunts",
  "version": "0.6.1",
  "type": "module",
  "description": "Fast offline CLI tool for instant English word-prefix search",
  "main": "./src/bin/cli.js",
  "bin": {
    "word-hunts": "./src/bin/cli.js",
    "wh": "./src/bin/cli.js"
  },
  "files": [
    "src/bin/**/*",
    "src/build/**/*",
    "src/commands/**/*",
    "src/printers/**/*",
    "src/services/**/*",
    "src/utils/**/*",
    "src/data/config.json",
    "src/data/words_dictionary.json",
    "readme.md",
    "LICENSE",
    ".npmignore"
  ],
  "scripts": {
    "start": "node ./src/bin/cli.js",
    "dev": "nodemon ./src/bin/cli.js",
    "build:dict": "node ./src/build/build-dict.js",
    "postinstall": "npm run build:dict"
  },
  "keywords": [
    "word-search",
    "cli",
    "dictionary",
    "word-games",
    "prefix-search",
    "last-letter"
  ],
  "author": "Mochamad Iqbal Maulana",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jimbonlemu/word-hunts.git"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.11"
  },
  "dependencies": {
    "cli-table3": "^0.6.5"
  }
}
